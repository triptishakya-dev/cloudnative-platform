# ─────────────────────────────────────────────────────────────────────────────
# CloudNativ Platform — .gitignore
# ─────────────────────────────────────────────────────────────────────────────

# ── Environment & Secrets ─────────────────────────────────────────────────────
.env
.env.*
!.env.example
!.env.*.example

# ── Dependencies ──────────────────────────────────────────────────────────────
node_modules/
.pnp
.pnp.js

# ── Build Outputs ─────────────────────────────────────────────────────────────
dist/
build/
out/
.next/
.turbo/

# ── Prisma ────────────────────────────────────────────────────────────────────
# Generated client (re-created by prisma contract emit)
**/generated/
# Local Composer dev state
.prisma-composer/
# Local Prisma project link
.prisma/local.json

# ── Logs ─────────────────────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
logs/

# ── OS & Editor ───────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln

# ── Testing & Coverage ────────────────────────────────────────────────────────
coverage/
.nyc_output/

# ── Docker local overrides ────────────────────────────────────────────────────
docker-compose.override.yml

# ── Misc ──────────────────────────────────────────────────────────────────────
*.tsbuildinfo
.cache/
tmp/


skill.md