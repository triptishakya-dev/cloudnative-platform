# Local development. Existing exported environment variables take precedence.
PORT=3002
HOST=0.0.0.0
DATABASE_URL=postgresql://cloudnative:change-me@127.0.0.1:5432/order_db
CATALOG_SERVICE_URL=http://127.0.0.1:3001
RABBITMQ_URL=amqp://cloudnative:change-me@127.0.0.1:5672?heartbeat=10
RABBITMQ_EXCHANGE=cloudnative.events
RABBITMQ_NOTIFICATION_QUEUE=notifications.orders
OUTBOX_POLL_MS=5000
OUTBOX_BATCH_SIZE=10
OUTBOX_MAX_ATTEMPTS=5

# Lease must exceed the whole publish deadline by at least 5000ms.
OUTBOX_LEASE_MS=120000
OUTBOX_PUBLISH_TIMEOUT_MS=30000
OUTBOX_RETRY_BASE_MS=5000
