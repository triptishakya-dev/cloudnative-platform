{
  "name": "order-service",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc --project tsconfig.json",
    "start": "node dist/server.js",
    "test": "tsx --test tests/orders.test.ts",
    "lint": "eslint src --ext .ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:push": "prisma db push",
    "test:messaging": "tsx --test tests/rabbitmq.test.ts tests/outbox.test.ts",
    "test:messaging:integration": "tsx --test tests/rabbitmq.integration.test.ts",
    "test:outbox:integration": "tsx --test tests/outbox.integration.test.ts"
  },
  "dependencies": {
    "@sinclair/typebox": "^0.33.0",
    "amqplib": "^2.4.1",
    "dotenv": "^18.0.10",
    "fastify": "^5.0.0",
    "fastify-plugin": "^5.0.0",
    "pino-pretty": "^13.0.0"
  },
  "devDependencies": {
    "@types/amqplib": "^0.10.8",
    "@types/node": "^22.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0"
  }
}
