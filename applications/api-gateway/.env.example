# ─────────────────────────────────────────────────────────────────────────────
# API Gateway — Environment Variables
# Copy this file to .env and fill in real values.
# Never commit the actual .env file.
# ─────────────────────────────────────────────────────────────────────────────

# ── App ───────────────────────────────────────────────────────────────────────
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
SERVICE_NAME=api-gateway

# ── Upstream Services ─────────────────────────────────────────────────────────
CATALOG_SERVICE_URL=http://localhost:3001
ORDER_SERVICE_URL=http://localhost:3002

# ── Authentication ────────────────────────────────────────────────────────────
JWT_SECRET=super-secret-change-in-production
JWT_EXPIRES_IN=15m

# ── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_MAX=100          # requests per window per IP
RATE_LIMIT_WINDOW_MS=60000  # window in milliseconds (60 s)

# ── Proxy ─────────────────────────────────────────────────────────────────────
PROXY_TIMEOUT_MS=30000      # upstream request timeout

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=info              # debug | info | warn | error
LOG_FORMAT=pretty           # pretty | json

# ── CORS ─────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000

# Customer accounts (separate database)
AUTH_DATABASE_URL=postgresql://cloudnative:change-me@127.0.0.1:5432/auth_db
AUTH_DATABASE_ADMIN_URL=postgresql://cloudnative:change-me@127.0.0.1:5432/cloudnative
# Optional only when running auth:setup to create a new administrator:
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=choose-a-unique-password-at-least-12-characters
