    "db:push": "prisma db push"
  },
  "dependencies": {
    "@sinclair/typebox": "^0.33.0",
    "fastify": "^5.0.0",
    "fastify-plugin": "^5.0.0",
    "pino-pretty": "^13.0.0",
    "dotenv": "^18.0.10"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0"
  }
}
