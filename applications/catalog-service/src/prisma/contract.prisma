generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/@cloudnative/catalog-prisma-client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id                String   @id @default(uuid()) @db.Uuid
  sku               String   @unique @db.VarChar(100)
  name              String   @db.VarChar(255)
  description       String?  @db.Text
  priceAmount       Decimal  @map("price_amount") @db.Decimal(12, 2)
  priceCurrency     String   @default("INR") @map("price_currency") @db.Char(3)
  inventoryQuantity Int      @default(0) @map("inventory_quantity")
  active            Boolean  @default(true)
  version           Int      @default(1)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([active])
  @@index([name])
  @@map("products")
}