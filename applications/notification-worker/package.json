{
  "name": "notification-worker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "db:setup": "tsx src/setup-db.ts",
    "test": "tsx --test tests/processor.test.ts",
    "test:integration": "tsx --test tests/integration.test.ts"
  },
  "dependencies": {
    "amqplib": "^2.4.1",
    "dotenv": "^18.0.10",
    "nodemailer": "^10.6.1",
    "pg": "^8.0.0",
    "pino": "^9.0.0"
  },
  "devDependencies": {
    "@types/amqplib": "^0.10.8",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^7.0.0",
    "@types/pg": "^8.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0"
  }
}
