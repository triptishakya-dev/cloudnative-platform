DATABASE_URL=postgresql://cloudnative:change-me@127.0.0.1:5432/notification_db
# Used only by db:setup to create the database on existing local installations.
DATABASE_ADMIN_URL=postgresql://cloudnative:change-me@127.0.0.1:5432/cloudnative
RABBITMQ_URL=amqp://cloudnative:change-me@127.0.0.1:5672?heartbeat=10
RABBITMQ_EXCHANGE=cloudnative.events
RABBITMQ_NOTIFICATION_QUEUE=notifications.orders
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
EMAIL_FROM=orders@cloudnative.local
RETRY_DELAY_MS=10000
MAX_RETRIES=3
RECONNECT_DELAY_MS=3000
LOG_LEVEL=info
